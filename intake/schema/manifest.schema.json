{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nercari/lume/intake/schema/manifest.schema.json",
  "title": "Lume private real-case manifest",
  "description": "Private. Lives in intake/private/ only. Case identity uses opaque IDs only.",
  "type": "object",
  "required": ["manifest_version", "cases", "pending_slices"],
  "additionalProperties": false,
  "properties": {
    "manifest_version": { "const": 1 },
    "split_exception": { "type": "string", "minLength": 1, "description": "Why the supplied set cannot have both tuning and held-out cases." },
    "cases": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/case" } },
    "pending_slices": { "type": "array", "items": { "$ref": "#/$defs/pending" } }
  },
  "$defs": {
    "slice": {
      "enum": ["long-record", "scans", "attachments", "late-decisive-evidence", "contradictions", "unreadable-restricted", "inventory-change"]
    },
    "caseId": { "type": "string", "pattern": "^case-[a-z0-9]{6,}$" },
    "docId": { "type": "string", "pattern": "^doc-[a-z0-9-]{1,32}$" },
    "itemId": { "type": "string", "pattern": "^[A-Z]{1,3}[0-9]{1,4}$" },
    "source": {
      "type": "object",
      "required": ["doc", "page"],
      "additionalProperties": false,
      "properties": { "doc": { "$ref": "#/$defs/docId" }, "page": { "type": "integer", "minimum": 1 } }
    },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "case": {
      "type": "object",
      "required": ["id", "split", "page_count", "slices", "annotation"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/caseId" },
        "split": { "enum": ["tuning", "held-out"] },
        "page_count": { "type": "integer", "minimum": 1 },
        "slices": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/slice" } },
        "annotation": { "$ref": "#/$defs/annotation" }
      }
    },
    "annotation": {
      "type": "object",
      "required": ["reviewer", "completed_before_evaluation", "decisive_facts", "contradictions", "gaps", "inventory"],
      "additionalProperties": false,
      "properties": {
        "reviewer": { "type": "string", "pattern": "^rev-[a-z0-9]{3,}$" },
        "completed_before_evaluation": { "const": true },
        "decisive_facts": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["id", "statement", "sources"], "additionalProperties": false,
            "properties": { "id": { "$ref": "#/$defs/itemId" }, "statement": { "type": "string", "minLength": 1 }, "sources": { "$ref": "#/$defs/sources" } }
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "description", "sources"], "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/itemId" }, "description": { "type": "string", "minLength": 1 },
              "sources": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/source" } }
            }
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "description"], "additionalProperties": false,
            "properties": { "id": { "$ref": "#/$defs/itemId" }, "description": { "type": "string", "minLength": 1 }, "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } } }
          }
        },
        "inventory": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["doc", "pages", "kind", "readable"], "additionalProperties": false,
            "properties": {
              "doc": { "$ref": "#/$defs/docId" },
              "pages": { "type": "integer", "minimum": 1 },
              "kind": { "enum": ["text", "scan", "attachment", "media", "other"] },
              "readable": { "type": "boolean" },
              "restricted": { "type": "boolean" },
              "added_late": { "type": "boolean", "description": "Document entered the record after an earlier inventory (inventory-change slice)." }
            }
          }
        }
      }
    },
    "pending": {
      "type": "object", "required": ["slice", "reason"], "additionalProperties": false,
      "properties": { "slice": { "$ref": "#/$defs/slice" }, "reason": { "type": "string", "minLength": 1 } }
    }
  }
}
